PORT=4000

# Path to the Firebase service account JSON (Project Settings > Service Accounts >
# Generate new private key, in the Firebase console for project "callmetaai").
# Never commit the actual key file — copy it next to this file as
# firebase-service-account.json (already gitignored) and point this at it.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# TURN vendor chosen 2026-07-06: ExpressTurn free tier (free.expressturn.com).
# Get your own credentials at https://www.expressturn.com/ and fill these in —
# never commit real values here, this file is the template. Real values go in
# the local .env (gitignored).
STUN_URLS=stun:free.expressturn.com:3478
TURN_URL=turn:free.expressturn.com:3478?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=

# mediasoup SFU — the announced address is what clients actually dial to
# reach the media server. Same rule as the rest of this backend: a physical
# device needs the host's real LAN IP here, not 127.0.0.1 (iOS Simulator
# only works with 127.0.0.1 since it shares the host's network stack).
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# Gemini Flash-Lite — get a key at https://aistudio.google.com/apikey.
# Real value goes in the local .env (gitignored), never here.
GEMINI_API_KEY=

# Deepgram — STT vendor chosen 2026-07-08 (switched from Google STT: no real
# free tier, Deepgram has ~$200 free credit, better fit for a portfolio
# project). Get a key at https://console.deepgram.com/.
# Real value goes in the local .env (gitignored), never here.
DEEPGRAM_API_KEY=

# Day 15 STT audio capture — port range ffmpeg listens on for RTP forwarded
# from mediasoup's PlainTransport (distinct from MEDIASOUP_MIN_PORT/MAX_PORT
# above, which is mediasoup's own WebRTC transport port range). Requires
# ffmpeg on PATH (`brew install ffmpeg`).
STT_RTP_MIN_PORT=30000
STT_RTP_MAX_PORT=30100
